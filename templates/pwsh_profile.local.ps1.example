# ~\.pwsh_profile.local.ps1
# マシン固有の PowerShell 設定 (git 管理外)。install.ps1 実行時にこのテンプレートからコピーされる。
# profile.ps1 の最後に読み込まれるので、共通の設定を上書きできる。

# 例: 会社のプロキシ
# $env:HTTP_PROXY  = 'http://proxy.example.com:8080'
# $env:HTTPS_PROXY = $env:HTTP_PROXY
# $env:NO_PROXY    = 'localhost,127.0.0.1,.example.com'

# 例: Bitwarden のアイテム名を変える
# $env:BW_ENV_ITEM = 'work-env'
