# ~/.zshrc
#
# 読み込み順:
#   1. ~/.zsh/*.zsh   (番号順: 00_cache -> 01_base -> 02_key_config -> 03_path -> 04_alias -> 06_secrets)
#   2. ~/.zshrc.local (git 管理しないマシン固有の設定)
#   3. sheldon        (プラグイン。autosuggestions / syntax-highlighting は zsh-defer で遅延ロード)
#   4. zsh-abbr の略語 / fzf / zoxide / starship
#   5. compinit       (補完の初期化は最後に一度だけ)
#
# 起動を軽くするため、外部コマンドの初期化スクリプトはキャッシュしている (00_cache.zsh)。
# 起動時間の内訳を見るには: ZPROF=1 zsh -i -c exit

[[ -n $ZPROF ]] && zmodload zsh/zprof

ZSHHOME="${HOME}/.zsh"

if [[ -d $ZSHHOME && -r $ZSHHOME ]]; then
    for i in $ZSHHOME/*.zsh(N); do
        [[ -r $i ]] && source $i
    done
fi

[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local

# -- Plugins (sheldon) -- #
# `sheldon source` の出力もキャッシュし、plugins.toml か lock ファイルが変わったときだけ作り直す
if (( $+commands[sheldon] )); then
    _sheldon_cache=$ZSH_CACHE_DIR/sheldon.zsh
    _sheldon_toml=${XDG_CONFIG_HOME:-$HOME/.config}/sheldon/plugins.toml
    _sheldon_lock=${XDG_DATA_HOME:-$HOME/.local/share}/sheldon/plugins.lock
    if [[ ! -s $_sheldon_cache || $_sheldon_toml -nt $_sheldon_cache || $_sheldon_lock -nt $_sheldon_cache ]]; then
        mkdir -p $ZSH_CACHE_DIR
        sheldon source >| $_sheldon_cache
    fi
    source $_sheldon_cache
    unset _sheldon_cache _sheldon_toml _sheldon_lock
fi

# -- Abbreviations (zsh-abbr) -- #
if (( $+functions[abbr] )); then
    abbr -S -q lg='lazygit'
    abbr -S -q lzdo='lazydocker'
fi

# -- fzf (Ctrl-T: ファイル検索 / Alt-C: ディレクトリ移動) -- #
_evalcache fzf fzf --zsh && source $REPLY
# Ctrl-R は fzf ではなく history-search-multi-word を使う
(( $+widgets[history-search-multi-word] )) && bindkey '^R' history-search-multi-word

# -- zoxide (z <キーワード> でよく使うディレクトリへ移動) -- #
_evalcache zoxide zoxide init zsh && source $REPLY

# -- Prompt (starship。設定は ~/.config/starship.toml で PowerShell と共通) -- #
_evalcache starship starship init zsh --print-full-init && source $REPLY

# -- Completion -- #
[[ -d ~/.docker/completions ]] && fpath=(~/.docker/completions $fpath)
autoload -Uz compinit && compinit -u

# 最後のコマンドの終了ステータスが最初のプロンプトの $? になるので、
# `[[ ... ]] && ...` (条件が偽だと 1) ではなく if を使う
if [[ -n $ZPROF ]]; then
    zprof
fi
